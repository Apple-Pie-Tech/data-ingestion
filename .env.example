# Runtime
CORS_ALLOW_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:8080,http://localhost:8080
STORY_LABELING_ENABLED=false
STORY_LABELING_API_BASE_URL=
STORY_LABELING_TIMEOUT_SECONDS=60
# The labelling function URL is IAM-authorized in deployment, so the trigger has
# to sign its request with SigV4. Leave false locally, where the target is a
# plain uvicorn with no authorizer in front of it.
STORY_LABELING_SIGN_REQUESTS=false
# Checked against the `x-api-key` header on POST /ingest. Leave blank to
# disable the check (local dev); the service logs a warning when it is unset.
INGEST_API_KEY=local-dev-ingest-key
# Set by Terraform instead of the value above. A secret value in a Lambda
# environment variable would be written to Terraform state in plaintext, so the
# deployment passes the Secrets Manager ARN and the service resolves it at
# startup. Leave blank locally and use the plain value above.
INGEST_API_KEY_SECRET_ARN=
MAX_AUDIO_BYTES=25000000
REQUEST_TIMEOUT_SECONDS=60
AUDIO_STORAGE_ENABLED=false
# S3 bucket for ingested audio. Created by Terraform; the service only writes.
# Credentials come from the Lambda execution role in deployment and from the
# ambient AWS profile locally -- no key in this file.
S3_AUDIO_BUCKET=

# S3 Vectors. Bucket and index are created by Terraform: the index pins the
# dimension (1536) and the non-filterable metadata keys at creation time, and a
# non-filterable key cannot be made filterable later, so the service validates
# the index rather than creating it.
S3_VECTOR_BUCKET=
S3_VECTOR_INDEX=apple-pie-story-chunks

# Bedrock (embeddings). Credentials come from the Lambda execution role in
# deployment and from the ambient AWS profile locally -- no key in this file.
AWS_REGION=us-east-1
BEDROCK_EMBEDDINGS_MODEL=cohere.embed-v4:0
EMBEDDING_MODEL=cohere.embed-v4:0
EMBEDDING_DIM=1536
SEMANTIC_SIMILARITY_THRESHOLD=0.8
MIN_CHUNK_CHARS=350
MAX_CHUNK_CHARS=1400
# Chonkie's chunk_size is a token budget, not characters.
MAX_CHUNK_TOKENS=350
CHUNK_OVERLAP_SENTENCES=1

# Gradium
GRADIUM_API_BASE_URL=https://api.gradium.ai/api
GRADIUM_API_KEY=
GRADIUM_API_KEY_SECRET_ARN=
GRADIUM_TRANSCRIPTION_MODEL=demo-transcription-model
GRADIUM_TRANSCRIPTION_TRANSPORT=rest
GRADIUM_TRANSCRIPTION_PATH=/post/speech/asr
GRADIUM_LANGUAGE=en
GRADIUM_TIMEOUT_SECONDS=60
SEMANTIC_TOKENIZER_ENCODING=cl100k_base
